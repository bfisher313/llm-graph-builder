# ============================================================
# Local Deployment Configuration
# ============================================================
# Copy this file to .env and replace YOUR_ZAI_API_KEY below.
#   cp example.env.local .env
# ============================================================

# --- LLM (the only value you need to change) ---
LLM_MODEL_CONFIG_GLM_5_1="glm-5.1,https://api.z.ai/api/paas/v4/,YOUR_ZAI_API_KEY"
DEFAULT_DIFFBOT_CHAT_MODEL="glm_5_1"
GRAPH_CLEANUP_MODEL="glm_5_1"

# --- Neo4j (matches docker-compose neo4j service) ---
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="llmgraphbuilder"
NEO4J_DATABASE="the-black-book-of-power"

# --- Embeddings (local, no external API needed) ---
OPENAI_API_KEY=""
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_PROVIDER="sentence-transformer"
IS_EMBEDDING="True"

# --- Graph Processing ---
KNN_MIN_SCORE="0.8"
UPDATE_GRAPH_CHUNKS_PROCESSED="20"
ENTITY_EMBEDDING="False"
DUPLICATE_SCORE_VALUE="0.97"
DUPLICATE_TEXT_DISTANCE="3"
EFFECTIVE_SEARCH_RATIO="5"
MAX_TOKEN_CHUNK_SIZE="10000"
